# I added the following rules to keep unnecessary files out of GitHub.

# Custom rules added for our IntelliJ Java project.
# Keep local IDE settings and generated files out of GitHub.

# IntelliJ local project settings
.idea/

# IntelliJ module configuration files
*.iml

# Generated compilation output
out/



# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

